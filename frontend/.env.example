# ==============================================================================
# ALLINONEBLOG - FRONTEND ENVIRONMENT CONFIGURATION (Vercel / Local)
# ==============================================================================

# Khi chạy Local:
# VITE_API_BASE_URL=http://localhost:5000/api
# VITE_SOCKET_URL=http://localhost:5000

# Khi deploy Frontend trên VERCEL:
# Thay link backend render bên dưới bằng domain thực tế từ Render Dashboard của bạn (vd: https://allinoneblog-backend.onrender.com)
VITE_API_BASE_URL=https://your-backend-app.onrender.com/api
VITE_SOCKET_URL=https://your-backend-app.onrender.com
