# ==============================================================================
# ALLINONEBLOG - BACKEND PRODUCTION ENVIRONMENT CONFIGURATION (Render / Production)
# ==============================================================================

# 1. Cấu hình Flask
FLASK_APP=run.py
FLASK_ENV=production
FLASK_DEBUG=0

# 2. Khóa bảo mật (Trên Render nhớ đổi sang chuỗi ngẫu nhiên dài và bảo mật)
SECRET_KEY=generate_a_random_32_byte_secret_key_for_production
JWT_SECRET_KEY=generate_another_random_32_byte_jwt_secret_key_for_production
JWT_ACCESS_TOKEN_EXPIRES=86400

# 3. Database URL:
# - Nếu dùng SQLite tạm: sqlite:///database.sqlite
# - Khi deploy Render hoặc Neon: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=sqlite:///database.sqlite

# 4. CORS Origins (QUAN TRỌNG: Phải chứa URL của Vercel frontend)
# Thêm domain Vercel của bạn vào đây (ngăn cách bởi dấu phẩy, không có dấu / ở cuối)
# Ví dụ: https://allinoneblog.vercel.app,http://localhost:5173
CORS_ORIGINS=https://your-frontend-app.vercel.app,http://localhost:5173

# 5. Lưu trữ Media & Watermark
UPLOAD_FOLDER=uploads
WATERMARK_TEXT=© allinoneblog.dev

# 6. Cloudinary CDN (KHUYÊN DÙNG khi deploy Render Free Tier vì ổ cứng Render sẽ bị reset)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
